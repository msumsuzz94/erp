# Business Management System - Apache Configuration
# .htaccess file

# Enable Rewrite Engine
RewriteEngine On
RewriteBase /business-management-system/

# Redirect HTTP to HTTPS (Enable in production)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Prevent directory listing
Options -Indexes

# Default index files
DirectoryIndex index.php index.html

# Protect configuration files
&lt;FilesMatch "^(config\.php|database\.php|constants\.php)$"&gt;
    &lt;IfVersion &lt; 2.4&gt;
        Order Allow,Deny
        Deny from all
    &lt;/IfVersion&gt;
    &lt;IfVersion &gt;= 2.4&gt;
        Require all denied
    &lt;/IfVersion&gt;
&lt;/FilesMatch&gt;

# Protect database schema file
&lt;Files "schema.sql"&gt;
    &lt;IfVersion &lt; 2.4&gt;
        Order Allow,Deny
        Deny from all
    &lt;/IfVersion&gt;
    &lt;IfVersion &gt;= 2.4&gt;
        Require all denied
    &lt;/IfVersion&gt;
&lt;/Files&gt;

# Protect .htaccess file
&lt;Files ".htaccess"&gt;
    &lt;IfVersion &lt; 2.4&gt;
        Order Allow,Deny
        Deny from all
    &lt;/IfVersion&gt;
    &lt;IfVersion &gt;= 2.4&gt;
        Require all denied
    &lt;/IfVersion&gt;
&lt;/Files&gt;

# PHP Settings
&lt;IfModule mod_php7.c&gt;
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
    php_flag display_errors Off
    php_flag log_errors On
&lt;/IfModule&gt;

# Gzip Compression (optional - for better performance)
&lt;IfModule mod_deflate.c&gt;
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
&lt;/IfModule&gt;

# ========================================
# CACHE CONTROL CONFIGURATION
# ========================================

# ----------------------------------------
# NO CACHE for PHP files (Dynamic Content)
# ----------------------------------------
&lt;FilesMatch "\.(php)$"&gt;
    &lt;IfModule mod_headers.c&gt;
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    &lt;/IfModule&gt;
&lt;/FilesMatch&gt;

# ----------------------------------------
# AGGRESSIVE CACHE for Static Assets with Versioning
# ----------------------------------------
&lt;IfModule mod_expires.c&gt;
    ExpiresActive On
    
    # Images - Long cache (1 year)
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # CSS and JavaScript - Medium cache (1 month)
    # Note: We use version parameters for cache busting
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    
    # Fonts - Long cache (1 year)
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    
    # Documents - Short cache (1 week)
    ExpiresByType application/pdf "access plus 1 week"
    ExpiresByType application/zip "access plus 1 week"
&lt;/IfModule&gt;

# ----------------------------------------
# Cache-Control Headers for Static Assets
# ----------------------------------------
&lt;IfModule mod_headers.c&gt;
    # Images
    &lt;FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$"&gt;
        Header set Cache-Control "public, max-age=31536000, immutable"
    &lt;/FilesMatch&gt;
    
    # CSS and JavaScript - Can be cached but revalidate
    # Our version parameter will handle cache busting
    &lt;FilesMatch "\.(css|js)$"&gt;
        Header set Cache-Control "public, max-age=2592000, must-revalidate"
    &lt;/FilesMatch&gt;
    
    # Fonts
    &lt;FilesMatch "\.(woff|woff2|ttf|eot)$"&gt;
        Header set Cache-Control "public, max-age=31536000, immutable"
    &lt;/FilesMatch&gt;
&lt;/IfModule&gt;

# Custom Error Pages (optional)
# ErrorDocument 404 /business-management-system/404.php
# ErrorDocument 403 /business-management-system/403.php
# ErrorDocument 500 /business-management-system/500.php

# Protect against clickjacking
&lt;IfModule mod_headers.c&gt;
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
&lt;/IfModule&gt;

# Disable server signature
ServerSignature Off
