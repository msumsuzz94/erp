<?php
/**
 * Sales Report Page
 */

require_once __DIR__ . '/../../config/config.php';
require_once __DIR__ . '/../../includes/functions.php';
require_once __DIR__ . '/../../includes/db_functions.php';
require_once __DIR__ . '/../../includes/auth.php';

require_login();

// Get filter parameters
$from_date = get_param('from_date', date('Y-m-01'));
$to_date = get_param('to_date', date('Y-m-d'));
$customer_id = get_param('customer_id', '');
$payment_status = get_param('payment_status', '');

// Build query
$sql = "SELECT s.*, c.name as customer_name
        FROM sales s
        LEFT JOIN customers c ON s.customer_id = c.id
        WHERE s.status = 'completed'
        AND s.sale_date BETWEEN ? AND ?";

$params = [$from_date, $to_date];

if (!empty($customer_id)) {
    $sql .= " AND s.customer_id = ?";
    $params[] = $customer_id;
}

if (!empty($payment_status)) {
    $sql .= " AND s.payment_status = ?";
    $params[] = $payment_status;
}

$sql .= " ORDER BY s.sale_date DESC";
$sales = db_query($sql, $params);

// Fetch returns for the same period/customer
$return_sql = "SELECT sr.*, c.name as customer_name
               FROM sales_returns sr
               LEFT JOIN customers c ON sr.customer_id = c.id
               WHERE sr.status = 'completed'
               AND sr.return_date BETWEEN ? AND ?";
$return_params = [$from_date, $to_date];
if (!empty($customer_id)) {
    $return_sql .= " AND sr.customer_id = ?";
    $return_params[] = $customer_id;
}
$returns = db_query($return_sql, $return_params);

// Calculate totals
$total_sales = 0;
$total_paid = 0;
$total_due = 0;
$total_tax = 0;
$total_discount = 0;

foreach ($sales as $sale) {
    $total_sales += $sale['total_amount'];
    $total_paid += $sale['paid_amount'];
    $total_due += $sale['due_amount'];
    $total_tax += $sale['tax_amount'];
    $total_discount += $sale['discount'];
}

$total_returns = 0;
foreach ($returns as $ret) {
    $total_returns += $ret['total_amount'];
}
$net_sales = $total_sales - $total_returns;

// Get all customers for filter dropdown
$customers = db_query("SELECT id, name FROM customers ORDER BY name ASC");

// Get business settings for header
$invoice_settings = db_select_one('invoice_settings', ['id' => 1]);
if (!$invoice_settings) {
    $invoice_settings = [
        'company_name' => defined('BUSINESS_NAME') ? BUSINESS_NAME : '',
        'company_address' => defined('BUSINESS_ADDRESS') ? BUSINESS_ADDRESS : '',
        'company_phone' => defined('BUSINESS_PHONE') ? BUSINESS_PHONE : '',
        'company_email' => defined('BUSINESS_EMAIL') ? BUSINESS_EMAIL : '',
        'company_website' => '',
        'company_logo' => 'assets/images/logo.png',
        'company_slogan' => ''
    ];
}

$page_title = 'Sales Report';
include __DIR__ . '/../../templates/header.php';
?>

